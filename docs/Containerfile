# Serves the site Hugo built into public/ under /nats-operator/ on port 8080,
# as an unprivileged user.
FROM docker.io/nginxinc/nginx-unprivileged:1.31-alpine@sha256:b5047b9b76845eac124358373c6852377c52e4b05834a47647e955dd91cb8f1e
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY public/ /usr/share/nginx/html/nats-operator/
EXPOSE 8080
