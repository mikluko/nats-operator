{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabledManagers": ["custom.regex", "dockerfile", "github-actions", "gomod"],
  "minimumReleaseAge": "7 days",
  "semanticCommits": "enabled",
  "dockerfile": {
    "managerFilePatterns": ["/(^|/)machine\\.Containerfile$/"]
  },
  "postUpdateOptions": ["gomodTidy"],
  "packageRules": [
    {
      "description": "Actions and Go modules, weekly",
      "matchManagers": ["github-actions", "gomod"],
      "schedule": ["* * * * 1"]
    },
    {
      "description": "Renovate itself, weekly",
      "matchPackageNames": ["renovate"],
      "schedule": ["* * * * 1"]
    },
    {
      "description": "A kind node image is built for one kind release",
      "matchPackageNames": ["sigs.k8s.io/kind", "kubernetes-sigs/kind", "kindest/node"],
      "groupName": "kind"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Helm, wherever setup-helm installs it",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.yml$/"],
      "matchStrings": ["uses: azure/setup-helm@\\S+ # \\S+\\s+with:\\s+version: (?<currentValue>v\\S+)"],
      "depNameTemplate": "helm/helm",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Helm in the e2e machine",
      "managerFilePatterns": ["/^hack/e2e/machine\\.sh$/"],
      "matchStrings": ["helm_version=(?<currentValue>v\\S+)"],
      "depNameTemplate": "helm/helm",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "helm-unittest; the PR fails ci until HELM_UNITTEST_SHA256 is the new release's",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.yml$/"],
      "matchStrings": ["HELM_UNITTEST_VERSION: (?<currentValue>v\\S+)\\s+HELM_UNITTEST_SHA256: [0-9a-f]{64}"],
      "depNameTemplate": "helm-unittest/helm-unittest",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "ko, wherever setup-ko installs it",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.yml$/"],
      "matchStrings": ["uses: ko-build/setup-ko@\\S+ # \\S+\\s+with:\\s+version: (?<currentValue>v\\S+)"],
      "depNameTemplate": "ko-build/ko",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "just, wherever setup-just installs it",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.yml$/"],
      "matchStrings": ["uses: extractions/setup-just@\\S+ # \\S+\\s+with:\\s+just-version: (?<currentValue>\\S+)"],
      "depNameTemplate": "casey/just",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "zizmor, wherever zizmor-action runs it",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.yml$/"],
      "matchStrings": ["uses: zizmorcore/zizmor-action@\\S+ # \\S+\\s+with:\\s+version: (?<currentValue>\\S+)"],
      "depNameTemplate": "zizmorcore/zizmor",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "Renovate, wherever a workflow runs its config validator",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.yml$/"],
      "matchStrings": ["npx --yes --package (?<depName>renovate)@(?<currentValue>\\S+) "],
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "Go commands a workflow runs at a version",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.yml$/"],
      "matchStrings": ["go run (?<depName>[^@\\s]+?)/cmd/[^@\\s]+@(?<currentValue>v\\S+)"],
      "datasourceTemplate": "go"
    },
    {
      "customType": "regex",
      "description": "Hugo; the PR fails ci until HUGO_SHA256 is the new release's",
      "managerFilePatterns": ["/^\\.github/actions/setup-hugo/action\\.yml$/"],
      "matchStrings": ["HUGO_VERSION: (?<currentValue>\\S+)"],
      "depNameTemplate": "gohugoio/hugo",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "lychee; the PR fails until the Justfile's checksums are the new release's",
      "managerFilePatterns": ["/^Justfile$/"],
      "matchStrings": ["lychee_version := \"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "lycheeverse/lychee",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^lychee-v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "The exporter sidecar's default image, its tag and digest together",
      "managerFilePatterns": ["/^internal/natscluster/objects\\.go$/"],
      "matchStrings": ["ExporterTag\\s+= \"(?<currentValue>[^\"]+)\"\\s+ExporterDigest\\s+= \"(?<currentDigest>sha256:[0-9a-f]{64})\""],
      "depNameTemplate": "natsio/prometheus-nats-exporter",
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "The controller images' base, a digest of its latest tag",
      "managerFilePatterns": ["/^\\.ko\\.yaml$/"],
      "matchStrings": ["defaultBaseImage: (?<depName>[^@\\s]+)@(?<currentDigest>sha256:[0-9a-f]{64})"],
      "currentValueTemplate": "latest",
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "chart-testing, wherever chart-testing-action installs it",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.yml$/"],
      "matchStrings": ["uses: helm/chart-testing-action@\\S+ # \\S+\\s+with:\\s+version: (?<currentValue>\\S+)"],
      "depNameTemplate": "helm/chart-testing",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "kind, wherever kind-action installs it",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.yml$/"],
      "matchStrings": ["uses: helm/kind-action@\\S+ # \\S+\\s+with:\\s+version: (?<currentValue>v\\S+)"],
      "depNameTemplate": "kubernetes-sigs/kind",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "The kind node image, by tag and digest",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.yml$/", "/^internal/e2e/kind\\.go$/"],
      "matchStrings": ["(?<depName>kindest/node):(?<currentValue>v[0-9.]+)@(?<currentDigest>sha256:[0-9a-f]{64})"],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "The helm test image, by tag and digest",
      "managerFilePatterns": ["/^charts/nats-operator/values\\.yaml$/"],
      "matchStrings": ["tests:\\s+image:\\s+repository: (?<depName>\\S+)\\s+tag: \"(?<currentValue>[^\"]+)\"\\s+digest: \"(?<currentDigest>sha256:[0-9a-f]{64})\""],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "The helm test image's defaults in the chart reference page",
      "managerFilePatterns": ["/^docs/content/docs/reference/chart\\.md$/"],
      "matchStrings": ["\\| `tests\\.image\\.repository` \\| `(?<depName>[^`]+)` \\|[^\\n]*\\n\\| `tests\\.image\\.tag` \\| `\"(?<currentValue>[^\"]+)\"` \\|[^\\n]*\\n\\| `tests\\.image\\.digest` \\| `\"(?<currentDigest>sha256:[0-9a-f]{64})\"`"],
      "datasourceTemplate": "docker"
    }
  ]
}
